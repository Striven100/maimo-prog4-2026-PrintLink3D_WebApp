rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return signedIn() && currentUser().data.role == role;
    }

    function isJobOwner(jobId) {
      return signedIn() && get(/databases/$(database)/documents/jobs/$(jobId)).data.clientId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    match /jobs/{jobId} {
      allow read: if signedIn()
        && (hasRole("worker") || resource.data.clientId == request.auth.uid || ("workerId" in resource.data && resource.data.workerId == request.auth.uid));
      allow create: if hasRole("client") && request.resource.data.clientId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.clientId == request.auth.uid
        || ("workerId" in resource.data && resource.data.workerId == request.auth.uid)
        || (
          hasRole("worker")
          && resource.data.status == "published"
          && request.resource.data.status == "with_offers"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
        )
      );
      allow delete: if signedIn() && resource.data.clientId == request.auth.uid;
    }

    match /offers/{offerId} {
      allow read: if signedIn()
        && (resource.data.workerId == request.auth.uid || isJobOwner(resource.data.jobId));
      allow create: if hasRole("worker") && request.resource.data.workerId == request.auth.uid;
      allow update: if signedIn() && isJobOwner(resource.data.jobId);
      allow delete: if signedIn() && resource.data.workerId == request.auth.uid;
    }

    match /savedJobs/{savedId} {
      allow read, delete: if signedIn() && resource.data.workerId == request.auth.uid;
      allow create: if hasRole("worker") && request.resource.data.workerId == request.auth.uid;
      allow update: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.workerId == resource.data.workerId;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow update, delete: if false;
      }
    }

    match /portfolioItems/{itemId} {
      allow read: if signedIn();
      allow create: if hasRole("worker") && request.resource.data.workerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.workerId == request.auth.uid;
    }
  }
}
